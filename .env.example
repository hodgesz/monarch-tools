MONARCH_EMAIL=your-email@example.com
MONARCH_PASSWORD=your-monarch-password
# Optional: TOTP secret for MFA (from Monarch security settings)
# MONARCH_MFA_SECRET=your-totp-secret

# Email delivery (Gmail App Password required — see https://myaccount.google.com/apppasswords)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
ALERT_RECIPIENTS=your-email@gmail.com

# Optional: your name as it appears as the "merchant" on self-transfers.
# When set, those transactions are filtered out of income calculations.
# MONARCH_ACCOUNT_HOLDER=Your Name

# Alert thresholds (all optional, shown values are defaults)
# ALERT_LARGE_PURCHASE_THRESHOLD=100
# ALERT_BUDGET_WARNING_PERCENT=80
# ALERT_BUDGET_EXCEEDED_PERCENT=100
# ALERT_ANOMALY_MULTIPLIER=1.5
# ALERT_UPCOMING_BILLS_DAYS=7
